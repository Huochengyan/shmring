{
  "name": "shmring",
  "version": "0.1.0",
  "description": "Lock-free cross-language shared-memory ring buffer: single writer, many readers, zero HTTP",
  "main": "index.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "meta_codes",
  "keywords": [
    "shared-memory", "ring-buffer", "ipc", "seqlock", "electron",
    "python", "zero-copy", "frame", "lock-free"
  ],
  "engines": { "node": ">=18" },
  "os": ["win32", "linux", "darwin"],
  "files": [
    "index.js", "lib/",
    "examples/node_reader.js", "examples/node_writer.js",
    "examples/python_reader.py", "examples/python_writer.py",
    "examples/electron-camera/README.md",
    "examples/electron-camera/package.json",
    "examples/electron-camera/main.js",
    "examples/electron-camera/preload.js",
    "examples/electron-camera/node-shm-reader.js",
    "examples/electron-camera/python/server.py",
    "examples/electron-camera/python/requirements.txt",
    "examples/electron-camera/renderer/index.html",
    "examples/electron-camera/renderer/renderer.js",
    "examples/electron-camera/renderer/style.css",
    "PROTOCOL.md", "README.md", "LICENSE", "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "example:read": "node examples/node_reader.js",
    "example:write": "node examples/node_writer.js"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Huochengyan/shmring.git"
  },
  "bugs": { "url": "https://github.com/Huochengyan/shmring/issues" },
  "homepage": "https://github.com/Huochengyan/shmring"
}
